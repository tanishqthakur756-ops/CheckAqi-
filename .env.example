# Frontend Environment Variables
# API endpoint for backend services
PUBLIC_API_URL=http://localhost:8000

# Enable/disable features
PUBLIC_ENABLE_FORECASTS=true
PUBLIC_ENABLE_COMPARISONS=true

# Analytics (optional)
PUBLIC_GA_ID=

# Backend Environment Variables (for backend/.env)
# Database Configuration
DATABASE_URL=sqlite:///aqi_tracker.db
# For PostgreSQL: postgresql://user:password@localhost/aqi_db

# Environment
ENVIRONMENT=development
DEBUG=true

# API Configuration
API_TITLE=India AQI Tracker API
API_VERSION=1.0.0
CORS_ORIGINS=["http://localhost:4321", "http://localhost:3000"]

# Server
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
