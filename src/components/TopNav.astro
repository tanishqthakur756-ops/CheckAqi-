---
import BrandMark from "./BrandMark.astro";
import SearchModal from "./SearchModal.astro";
import { loadDistricts } from "../lib/loaders";

const districts = (await loadDistricts()).data;

const navItems = [
  { href: "/", label: "Overview" },
  { href: "/dashboard", label: "Live dashboard" },
  { href: "/districts", label: "Districts" },
  { href: "/sources", label: "Data sources" },
];

const currentPath = Astro.url.pathname;
function isCurrent(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(href + "/");
}
---

<header class="top-nav">
  <div class="container-prose flex items-center justify-between h-full gap-4">
    <a
      href="/"
      class="flex items-center gap-2 text-ink no-underline shrink-0"
      aria-label="India AQI Tracker — home"
    >
      <BrandMark size={22} variant="primary" />
      <span class="display-sm" style="font-size:20px; line-height:1;">
        AQI<span class="text-primary">.</span>in
      </span>
    </a>

    <nav
      class="hidden md:flex items-center gap-1"
      aria-label="Primary navigation"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="nav-link"
            aria-current={isCurrent(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <!-- Search Modal Trigger Button -->
      <button
        type="button"
        data-open-search-btn
        class="flex items-center gap-2 px-3 py-1.5 text-xs font-medium text-muted bg-surface-soft hover:text-ink hover:bg-surface-card border hairline rounded-lg transition-colors cursor-pointer"
        aria-label="Search districts"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="hidden sm:inline">Search...</span>
        <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] bg-canvas border hairline rounded font-mono">
          ⌘K
        </kbd>
      </button>

      <div class="hidden md:flex items-center gap-2">
        <a href="/dashboard" class="btn btn-link">Open dashboard</a>
        <a href="/about" class="btn btn-primary">How it works</a>
      </div>

      <button
        type="button"
        class="md:hidden btn btn-secondary"
        style="height:36px; padding:0 12px;"
        aria-label="Toggle menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-mobile-menu-toggle
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="mobile-menu md:hidden absolute left-0 right-0 top-16 z-30 bg-canvas border-b hairline-soft border-t"
    role="dialog"
    aria-label="Mobile navigation"
  >
    <div class="container-prose py-4 flex flex-col gap-1">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="nav-link"
            style="padding:12px;"
            aria-current={isCurrent(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a href="/about" class="btn btn-primary mt-3 self-start">
        How it works
      </a>
    </div>
  </div>
</header>

<SearchModal districts={districts} />

<script>
  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-mobile-menu-toggle]",
  );
  const menu = document.getElementById("mobile-menu");
  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const open = menu.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(open));
    });
    menu.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).tagName === "A") {
        menu.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
      }
    });
  }

  const searchBtn = document.querySelector<HTMLButtonElement>("[data-open-search-btn]");
  if (searchBtn) {
    searchBtn.addEventListener("click", () => {
      (window as unknown as { openSearchModal?: () => void }).openSearchModal?.();
    });
  }
</script>
