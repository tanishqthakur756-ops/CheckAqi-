---
interface Props {
  class?: string;
  size?: number;
  variant?: "ink" | "primary" | "on-dark";
}
const {
  class: className = "",
  size = 18,
  variant = "ink",
} = Astro.props as Props;
const color =
  variant === "primary"
    ? "var(--color-primary)"
    : variant === "on-dark"
      ? "var(--color-on-dark)"
      : "var(--color-ink)";
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={color}
  class={className}
  aria-hidden="true"
>
  <!-- 4-spoke radial mark + small dots, similar to the Anthropic "spike" -->
  <rect x="11" y="2" width="2" height="6" rx="1" />
  <rect x="11" y="16" width="2" height="6" rx="1" />
  <rect x="2" y="11" width="6" height="2" rx="1" />
  <rect x="16" y="11" width="6" height="2" rx="1" />
  <circle cx="12" cy="12" r="2.2" />
  <circle cx="3" cy="3" r="1" />
  <circle cx="21" cy="3" r="1" />
  <circle cx="3" cy="21" r="1" />
  <circle cx="21" cy="21" r="1" />
</svg>
