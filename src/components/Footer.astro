---
import BrandMark from "./BrandMark.astro";

const cols: { heading: string; links: { label: string; href: string }[] }[] = [
  {
    heading: "Product",
    links: [
      { label: "Live dashboard", href: "/dashboard" },
      { label: "District map", href: "/districts" },
      { label: "Seasonal patterns", href: "/dashboard#seasonal" },
      { label: "Weather correlation", href: "/dashboard#correlation" },
    ],
  },
  {
    heading: "Data",
    links: [
      { label: "Sources", href: "/sources" },
      { label: "API reference", href: "/sources#api" },
      { label: "Methodology", href: "/about" },
      { label: "Coverage", href: "/about#coverage" },
    ],
  },
  {
    heading: "Region",
    links: [
      { label: "North India", href: "/districts#north" },
      { label: "South India", href: "/districts#south" },
      { label: "East India", href: "/districts#east" },
      { label: "West India", href: "/districts#west" },
    ],
  },
  {
    heading: "About",
    links: [
      { label: "How it works", href: "/about" },
      { label: "Project", href: "/about#project" },
      { label: "Open data", href: "/sources" },
      { label: "Contact", href: "/about#contact" },
    ],
  },
];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container-prose">
    <div
      class="flex flex-col md:flex-row md:items-end md:justify-between gap-8 pb-10 border-b"
      style="border-color:#2a2723;"
    >
      <div>
        <a
          href="/"
          class="flex items-center gap-2 text-on-dark no-underline"
          aria-label="India AQI Tracker — home"
        >
          <BrandMark size={22} variant="on-dark" />
          <span class="display-sm" style="font-size:22px; line-height:1;">
            AQI<span class="text-primary">.</span>in
          </span>
        </a>
        <p class="mt-3 max-w-md" style="color: var(--color-on-dark-soft);">
          Open, district-level air quality and weather intelligence for India.
          Built on CPCB, Open-Meteo and IMD open data.
        </p>
      </div>

      <a
        href="/dashboard"
        class="btn btn-secondary-on-dark self-start md:self-end"
        aria-label="Open the live dashboard"
      >
        Open the dashboard
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <div
      class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-4 gap-8 py-10"
    >
      {
        cols.map((col) => (
          <div>
            <h3
              class="text-on-dark"
              style="font-size:12px; font-weight:500; letter-spacing:1.5px; text-transform:uppercase; color:var(--color-on-dark-soft); margin-bottom:14px;"
            >
              {col.heading}
            </h3>
            <ul class="flex flex-col gap-2 list-none p-0 m-0">
              {col.links.map((l) => (
                <li>
                  <a href={l.href} class="text-on-dark-soft">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-6"
      style="border-top: 1px solid #2a2723; color: var(--color-on-dark-soft);"
    >
      <p class="text-sm">
        © {year} AQI.in · Open data, no warranty on accuracy of seed figures.
      </p>
      <p class="text-sm flex items-center gap-2">
        <span class="badge badge-success" style="font-size:10px;">Live</span>
        <span>All systems operational.</span>
      </p>
    </div>
  </div>
</footer>
