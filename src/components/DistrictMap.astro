const statePaths = rawStateGeometries.map((st) => ({
  id: st.id,
  name: st.name,
  d: toSvgPath(st.points),
}));
---

<div
  class="relative w-full rounded-xl overflow-hidden shadow-sm transition-all duration-300"
  style={`max-width:${W}px; aspect-ratio:${W}/${H}; margin:auto; background:var(--color-canvas); border:1px solid var(--color-hairline);`}
  data-district-map
>
  <!-- Map Toolbar Controls -->
  <div class="absolute top-3 left-3 z-10 flex items-center gap-1.5 p-1 rounded-md bg-canvas/90 backdrop-blur border hairline shadow-xs flex-wrap">
    <button
      type="button"
      data-map-mode="dots"
      class="px-2.5 py-1 text-xs font-medium rounded transition-colors bg-surface-card text-ink"
    >
      📍 District Dots
    </button>
    <button
      type="button"
      data-map-mode="heatmap"
      class="px-2.5 py-1 text-xs font-medium rounded transition-colors text-muted hover:text-ink"
    >
      🗺️ State Heatmap
    </button>
    <button
      type="button"
      data-map-fullscreen
      class="px-2.5 py-1 text-xs font-medium rounded transition-colors text-muted hover:text-ink border-l hairline pl-2"
      title="Toggle Fullscreen"
    >
      ⛶ Fullscreen
    </button>
  </div>

  <svg
    viewBox={`0 0 ${W} ${H}`}
    width="100%"
    height="100%"
    role="img"
    aria-label="Interactive physical map of India districts with AQI readings"
    class="w-full h-full"
  >
    <defs>
      <radialGradient id="selected-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--color-primary)" stop-opacity="0.85" />
        <stop offset="100%" stop-color="var(--color-primary)" stop-opacity="0" />
      </radialGradient>
    </defs>

    <!-- Physical State & UT Boundaries -->
    <g data-layer="states">
      {
        statePaths.map((st) => {
          const stateData = stateAvgMap[st.name] || Object.values(stateAvgMap)[0];
          const avgAqi = stateData?.avg ?? null;
          const cat = categoryFromAqi(avgAqi);
          const color = categoryColor(cat);

          return (
            <path
              d={st.d}
              data-state-id={st.id}
              data-state-name={st.name}
              data-state-aqi={avgAqi ?? ""}
              data-state-color={color}
              fill="var(--color-surface-soft)"
              stroke="var(--color-hairline)"
              stroke-width="1.2"
              stroke-linejoin="round"
              class="transition-all duration-300 hover:opacity-90"
              style="cursor:pointer;"
            >
              <title>{st.name}{avgAqi ? ` — Avg AQI ${avgAqi}` : ""}</title>
            </path>
          );
        })
      }
    </g>

    <!-- District Centroid Markers -->
    <g data-layer="districts">
      {
        placed.map((p) => {
          const r = p.hasData ? (p.isPredicted ? 5 : 6) : 3;
          const color = categoryColor(p.cat);
          const isSel = p.id === selectedId;

          return (
            <g
              style="cursor:pointer;"
              data-district-id={p.id}
              data-district-name={p.name}
              data-district-state={p.state}
              data-district-aqi={p.aqi ?? ""}
              data-district-cat={p.cat}
              data-district-coverage={p.coverageType}
              data-district-confidence={p.confidence ?? ""}
              class="group"
            >
              {isSel && (
                <circle
                  cx={p.x}
                  cy={p.y}
                  r={r + 10}
                  fill="url(#selected-glow)"
                  class="animate-pulse"
                />
              )}
              <circle
                cx={p.x}
                cy={p.y}
                r={isSel ? r + 3 : r}
                fill={p.hasData ? color : "var(--color-hairline)"}
                fill-opacity={p.hasData ? (p.isPredicted ? 0.8 : 0.95) : 0.5}
                stroke={
                  isSel
                    ? "var(--color-ink)"
                    : p.isPredicted
                    ? "var(--color-primary)"
                    : "var(--color-canvas)"
                }
                stroke-width={isSel ? 2.5 : p.isPredicted ? 1.5 : 1}
                stroke-dasharray={p.isPredicted ? "2 2" : undefined}
                class="transition-all duration-200 group-hover:r-8"
              />
            </g>
          );
        })
      }
    </g>
  </svg>

  <!-- Interactive Floating Tooltip -->
  <div
    data-map-tooltip
    class="absolute pointer-events-none hidden bg-canvas border hairline shadow-lg rounded-lg px-3 py-2 text-xs transition-opacity duration-150 z-20"
    style="transform: translate(-50%, -120%);"
  >
    <div class="font-medium text-ink" data-tooltip-title>—</div>
    <div class="text-muted text-[11px]" data-tooltip-state>—</div>
    <div class="mt-1 flex items-center gap-1.5">
      <span class="badge font-medium text-[10px]" data-tooltip-badge>—</span>
      <span class="text-[10px] text-muted-soft" data-tooltip-type>Station</span>
    </div>
  </div>

  <!-- Legend -->
  <div
    class="absolute bottom-2 right-2 text-xs text-muted flex flex-wrap gap-2 items-center"
    style="background:rgba(250,249,245,0.92); padding:6px 10px; border-radius:8px; backdrop-filter: blur(4px); border:1px solid var(--color-hairline-soft);"
  >
    <span class="font-medium" style="color:var(--color-ink);">AQI</span>
    <span class="inline-flex items-center gap-1">
      <span class="w-2 h-2 rounded-full inline-block" style="background:#2a7a2a;"></span> Good
    </span>
    <span class="inline-flex items-center gap-1">
      <span class="w-2 h-2 rounded-full inline-block" style="background:#7a5a00;"></span> Moderate
    </span>
    <span class="inline-flex items-center gap-1">
      <span class="w-2 h-2 rounded-full inline-block" style="background:#8a4a00;"></span> Poor
    </span>
    <span class="inline-flex items-center gap-1">
      <span class="w-2 h-2 rounded-full inline-block" style="background:#c2452f;"></span> Very Poor
    </span>
    <span class="inline-flex items-center gap-1">
      <span class="w-2 h-2 rounded-full inline-block" style="background:#6e1b1b;"></span> Severe
    </span>
    <span class="inline-flex items-center gap-1 border-l pl-2 hairline">
      <span class="w-2 h-2 rounded-full inline-block border border-dashed border-primary bg-primary/30"></span> Predicted
    </span>
  </div>
</div>

<style>
  [data-district-map]:fullscreen {
    width: 100vw !important;
    height: 100vh !important;
    max-width: none !important;
    aspect-ratio: auto !important;
    border-radius: 0 !important;
    padding: 24px;
    background: var(--color-canvas) !important;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>

<script>
  const container = document.querySelector<HTMLElement>("[data-district-map]");
  if (container) {
    const tooltip = container.querySelector<HTMLElement>("[data-map-tooltip]");
    const titleEl = container.querySelector<HTMLElement>("[data-tooltip-title]");
    const stateEl = container.querySelector<HTMLElement>("[data-tooltip-state]");
    const badgeEl = container.querySelector<HTMLElement>("[data-tooltip-badge]");
    const typeEl = container.querySelector<HTMLElement>("[data-tooltip-type]");

    const modeBtns = container.querySelectorAll<HTMLButtonElement>("[data-map-mode]");
    const fullscreenBtn = container.querySelector<HTMLButtonElement>("[data-map-fullscreen]");
    const statePaths = container.querySelectorAll<SVGPathElement>("[data-state-id]");
    const districtDots = container.querySelectorAll<SVGGElement>("[data-district-id]");

    let currentMode: "dots" | "heatmap" = "dots";

    // Fullscreen Handler
    fullscreenBtn?.addEventListener("click", () => {
      if (!document.fullscreenElement) {
        container.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    });

    document.addEventListener("fullscreenchange", () => {
      const isFS = !!document.fullscreenElement;
      if (fullscreenBtn) {
        fullscreenBtn.textContent = isFS ? "↙ Exit Fullscreen" : "⛶ Fullscreen";
      }
    });

    // View mode handler
    modeBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const mode = btn.getAttribute("data-map-mode") as "dots" | "heatmap";
        if (!mode || mode === currentMode) return;
        currentMode = mode;

        modeBtns.forEach((b) => {
          b.classList.remove("bg-surface-card", "text-ink");
          b.classList.add("text-muted");
        });
        btn.classList.add("bg-surface-card", "text-ink");
        btn.classList.remove("text-muted");

        if (currentMode === "heatmap") {
          statePaths.forEach((path) => {
            const color = path.getAttribute("data-state-color");
            if (color) {
              path.setAttribute("fill", color);
              path.setAttribute("fill-opacity", "0.45");
            }
          });
        } else {
          statePaths.forEach((path) => {
            path.setAttribute("fill", "var(--color-surface-soft)");
            path.setAttribute("fill-opacity", "1");
          });
        }
      });
    });

    districtDots.forEach((g) => {
      g.addEventListener("mouseenter", (e) => {
        const name = g.getAttribute("data-district-name");
        const state = g.getAttribute("data-district-state");
        const aqi = g.getAttribute("data-district-aqi");
        const cat = g.getAttribute("data-district-cat");
        const coverage = g.getAttribute("data-district-coverage");
        const confidence = g.getAttribute("data-district-confidence");

        if (!tooltip || !name) return;

        titleEl!.textContent = name;
        stateEl!.textContent = state || "";

        if (aqi) {
          badgeEl!.textContent = `AQI ${Math.round(Number(aqi))} (${cat})`;
          badgeEl!.style.display = "inline-block";
        } else {
          badgeEl!.style.display = "none";
        }

        if (coverage === "predicted") {
          typeEl!.textContent = `Predicted via IDW (${confidence}% confidence)`;
        } else {
          typeEl!.textContent = "Direct CPCB Station";
        }

        const rect = container.getBoundingClientRect();
        const mouseX = e.clientX - rect.left;
        const mouseY = e.clientY - rect.top;

        tooltip.style.left = `${mouseX}px`;
        tooltip.style.top = `${mouseY}px`;
        tooltip.classList.remove("hidden");
      });

      g.addEventListener("mouseleave", () => {
        if (tooltip) tooltip.classList.add("hidden");
      });

      g.addEventListener("click", () => {
        const id = g.getAttribute("data-district-id");
        if (!id) return;
        const url = new URL(window.location.href);
        url.searchParams.set("district", id);
        history.replaceState(null, "", url.toString());

        const sel = document.querySelector<HTMLSelectElement>(
          "select[data-district-select]",
        );
        if (sel) {
          sel.value = id;
          sel.dispatchEvent(new Event("change", { bubbles: true }));
        }

        window.dispatchEvent(
          new CustomEvent("district:select", { detail: { id } }),
        );
      });
    });
  }
</script>
