---
/**
 * Detailed India Vector Map Component
 *
 * Features:
 * - Accurate physical geographic state boundaries computed via exact lat/lon projection
 * - District Centroid Markers mode
 * - State Heatmap Fill mode (toggleable)
 * - Fullscreen mode support
 * - Interactive tooltips & prediction status indicators
 * - Click interaction broadcasting 'district:select' custom event
 */
import type { DistrictListItem } from "../lib/types";
import { categoryFromAqi, categoryColor } from "../lib/aqi";

interface Props {
  districts: DistrictListItem[];
  selectedId?: string | null;
  size?: number;
}
const { districts, selectedId = null, size = 680 } = Astro.props as Props;

// Projection bounding box for India: lat 6.5..37.5, lon 68.0..97.5
const minLat = 6.5;
const maxLat = 37.5;
const minLon = 68.0;
const maxLon = 97.5;

function project(lat: number, lon: number, w: number, h: number) {
  const x = ((lon - minLon) / (maxLon - minLon)) * w;
  const y = ((maxLat - lat) / (maxLat - minLat)) * h;
  return { x, y };
}

const W = size;
const H = Math.round(size * 1.14);

function toSvgPath(points: [number, number][]) {
  return (
    points
      .map(([lat, lon], idx) => {
        const { x, y } = project(lat, lon, W, H);
        return `${idx === 0 ? "M" : "L"} ${x.toFixed(1)} ${y.toFixed(1)}`;
      })
      .join(" ") + " Z"
  );
}

const placed = districts
  .filter((d) => d.latitude != null && d.longitude != null)
  .map((d) => {
    const { x, y } = project(d.latitude!, d.longitude!, W, H);
    const cat = categoryFromAqi(d.latest_aqi);
    return {
      id: d.district_id,
      name: d.name,
      state: d.state,
      aqi: d.latest_aqi,
      cat,
      x,
      y,
      coverageType: d.coverage_type ?? "no_data",
      isPredicted: d.is_predicted || d.coverage_type === "predicted",
      confidence: d.prediction_confidence,
      hasData: d.latest_aqi != null,
    };
  });

// Compute state-level average AQI for Heatmap mode
const stateAvgMap: Record<string, { total: number; count: number; avg: number }> = {};
districts.forEach((d) => {
  if (d.latest_aqi != null) {
    if (!stateAvgMap[d.state]) {
      stateAvgMap[d.state] = { total: 0, count: 0, avg: 0 };
    }
    stateAvgMap[d.state].total += d.latest_aqi;
    stateAvgMap[d.state].count += 1;
    stateAvgMap[d.state].avg = Math.round(
      stateAvgMap[d.state].total / stateAvgMap[d.state].count,
    );
  }
});

/**
 * State & Union Territory boundaries constructed from physical Lat/Lon points
 * projected using the exact same formula as district centroids.
 */
const rawStateGeometries: { id: string; name: string; points: [number, number][] }[] = [
