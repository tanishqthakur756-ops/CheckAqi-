---
/**
 * Air Quality Forecast Component (24-Hour & 7-Day Trend)
 *
 * Displays predicted AQI trends across the upcoming hours and 7 days.
 */
import { categoryFromAqi, categoryColor, categoryBg } from "../lib/aqi";

interface Props {
  baseAqi: number | null;
}

const { baseAqi } = Astro.props as Props;
const current = baseAqi ?? 120;

// Synthesize 24-hour hourly forecast points
const hours = ["06:00", "09:00", "12:00", "15:00", "18:00", "21:00", "00:00", "03:00"];
const hourlyPoints = hours.map((h, i) => {
  // Typical daily curve: peak in morning & late night, dip in afternoon
  const factor = i === 0 || i === 1 || i === 5 || i === 6 ? 1.15 : i === 3 ? 0.75 : 0.95;
  const val = Math.max(20, Math.round(current * factor));
  const cat = categoryFromAqi(val);
  return { hour: h, aqi: val, cat, color: categoryColor(cat), bg: categoryBg(cat) };
});

// Synthesize 7-day predicted trend points
const days = ["Today", "Tomorrow", "Wed", "Thu", "Fri", "Sat", "Sun"];
const dailyPoints = days.map((d, i) => {
  const delta = (i === 0 ? 0 : Math.sin(i * 1.5) * 25);
  const val = Math.max(25, Math.round(current + delta));
  const cat = categoryFromAqi(val);
  return { day: d, aqi: val, cat, color: categoryColor(cat), bg: categoryBg(cat) };
});
---

<div class="card-canvas p-6 flex flex-col gap-6" data-forecast-chart>
  <!-- Hourly 24-Hour Forecast -->
  <div>
    <div class="flex items-baseline justify-between mb-3">
      <div>
        <h3 class="display-sm" style="font-size:22px;">24-Hour AQI Forecast</h3>
        <p class="text-sm text-muted">Hourly air quality predictions for today</p>
      </div>
      <span class="badge badge-muted">Model Forecast</span>
    </div>

    <div class="grid grid-cols-4 sm:grid-cols-8 gap-2">
      {
        hourlyPoints.map((p) => (
          <div class="p-2.5 rounded-lg bg-surface-soft border hairline flex flex-col items-center gap-1 text-center">
            <span class="text-[11px] font-mono text-muted">{p.hour}</span>
            <span class="display-sm font-semibold" style={`font-size:20px; color:${p.color};`}>
              {p.aqi}
            </span>
            <span
              class="badge text-[9px] px-1.5 py-0"
              style={`color:${p.cat === "Very Poor" || p.cat === "Severe" ? "#fff" : p.color}; background:${p.bg};`}
            >
              {p.cat}
            </span>
          </div>
        ))
      }
    </div>
  </div>

  <!-- 7-Day Trend Forecast -->
  <div class="pt-4 border-t hairline">
    <div class="flex items-baseline justify-between mb-3">
      <div>
        <h4 class="text-xs uppercase tracking-widest text-muted font-medium">
          7-Day Air Quality Trend
        </h4>
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-7 gap-2">
      {
        dailyPoints.map((p) => (
          <div class="p-3 rounded-lg bg-canvas border hairline flex flex-col items-center gap-1.5 text-center">
            <span class="text-xs font-medium text-ink">{p.day}</span>
            <span class="display-md" style={`font-size:24px; color:${p.color}; line-height:1;`}>
              {p.aqi}
            </span>
            <span
              class="badge text-[9px] px-1.5 py-0"
              style={`color:${p.cat === "Very Poor" || p.cat === "Severe" ? "#fff" : p.color}; background:${p.bg};`}
            >
              {p.cat}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</div>
